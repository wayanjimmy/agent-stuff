{
  "name": "jimbopi",
  "version": "1.0.0",
  "description": "Pi extension package",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "files": [
    "pi-extensions/",
    "pi-skills/"
  ],
  "type": "module",
  "scripts": {
    "fmt": "vp fmt package.json vite.config.ts tsconfig.json pi-extensions test",
    "fmt:check": "vp fmt --check package.json vite.config.ts tsconfig.json pi-extensions test",
    "test": "vp test run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "undici": "^8.10.2"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.87.0",
    "@earendil-works/pi-coding-agent": "^0.87.0",
    "@earendil-works/pi-tui": "^0.87.0",
    "@types/node": "^24.5.2",
    "typescript": "^5.9.3",
    "vite-plus": "^0.3.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./pi-extensions"
    ],
    "skills": [
      "./pi-skills"
    ]
  }
}
